# Copy this file to .env and fill in YOUR OWN Audible (Amazon) account credentials.
# Never commit the .env file: it is already listed in .gitignore.

# Default account, used by every test when no numbered account is defined
US_EMAIL=your-email@example.com
US_PASSWORD=your-password

# Optional: extra accounts to avoid conflicts when running tests in parallel.
# The suffix matches the Playwright worker index (0, 1, 2...) or the "accountIndex"
# set in a test. Any missing index falls back to US_EMAIL / US_PASSWORD.
# US_EMAIL_1=second-account@example.com
# US_PASSWORD_1=second-password
